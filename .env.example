# Copy to .env — never commit .env
APP_VERSION=development

# Also set collector.with_redis: true in backend/scheduler/config.yaml
REDISCLOUD_URL=

# CloudCube / S3 ephemerides (legacy)
CLOUDCUBE_URL=
CLOUDCUBE_ACCESS_KEY_ID=
CLOUDCUBE_SECRET_ACCESS_KEY=

# GPP connection token
GPP_DEVELOPMENT_TOKEN= # Only if gpp-client dev version is installed
GPP_TOKEN=

# Scheduler mode: VALIDATION/SIMULATION/REALTIME
SCHEDULER_MODE=

# Database URL matching HEROKU env connection.
DATABASE_URL=postgresql+asyncpg://scheduler:scheduler_dev@localhost:5433/scheduler


# Used by docker-compose to provision the postgres service.
DB_USER=scheduler
DB_PASSWORD=scheduler_dev
DB_NAME=scheduler

# Connection pool tuning (optional).
DB_POOL_SIZE=5
DB_POOL_OVERFLOW=10
DB_ECHO_SQL=false

# Weather URL service
WEATHER_URL= # Frontend endpoint to external weather service
VITE_WEATHER_URL= # Frontend endpoint to external weather service

# Variables used in Sight
# Can be set to ``sight`` or ``local`` if no internal configuration is needed
COLLECTOR_VISIBILITY_STRATEGY=local
# Removes the interlock for local development
VIS_AGG_INTERLOCK=false

# Kill switch. Set to true in CI and whenever you want the telemetry off.
OTEL_SDK_DISABLED=true

# OTEL configuration endpoints. Used for Grafana.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=service.namespace=gemini,deployment.environment=local

# Export cadence in ms. 60000 in a deploy; drop it for a local run so you do not
# wait a minute to see anything.
OTEL_METRIC_EXPORT_INTERVAL=60000

